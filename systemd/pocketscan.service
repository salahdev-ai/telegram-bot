[Unit]
Description=PocketScan Telegram Camera Bot
Documentation=https://github.com/salahdev-ai/telegram-bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__POCKETSCAN_DIR__
ExecStart=__POCKETSCAN_DIR__/venv/bin/python3 -m bot.main
EnvironmentFile=__POCKETSCAN_DIR__/.env
Environment=PYTHONPATH=__POCKETSCAN_DIR__
Environment=PATH=/home/__USER__/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

[Install]
WantedBy=multi-user.target
